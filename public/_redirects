# Netlify built-in services (Identity, Functions, Large Media) MUST NOT be
# caught by the SPA catch-all below. Add an explicit passthrough so the edge
# always forwards these requests to Netlify's own infrastructure.
/.netlify/identity /.netlify/identity 200
/.netlify/identity/* /.netlify/identity/:splat 200
/.netlify/functions/* /.netlify/functions/:splat 200

# Pass admin CMS static files (config.yml, index.html) through to the deploy directory
# This MUST come before the SPA catch-all below, otherwise Netlify serves
# index.html for every /admin/* request including config.yml → 404 in Decap CMS
/admin/* /admin/:splat 200

# SPA catch-all – serves index.html for all React-Router client-side routes
/* /index.html 200